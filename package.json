{
  "name": "topperbatch",
  "version": "1.0.0",
  "description": "TopperBatch — ISS SEM, 9 POINTER FIX! Private student community platform.",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "vercel-build": "cd client && npm install --include=dev && npm run build",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "db:migrate": "cd server && node database/migrate.js",
    "db:seed": "cd server && node database/seed.js",
    "migrate:supabase": "node scripts/migrate-sqlite-to-supabase.js",
    "migrate:storage": "node scripts/migrate-pdfs-to-supabase.js",
    "test": "cd server && npm test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3",
    "@supabase/supabase-js": "^2.49.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": "22.x"
  }
}

