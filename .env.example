# =============================================================================
# TopperBatch — Environment Configuration
# Tagline: "ISS SEM, 9 POINTER FIX!"
# =============================================================================
# Copy this file to .env and fill in values.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Security ---
JWT_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=change-this-to-another-random-secret
COOKIE_DOMAIN=localhost

# --- Permanent Administrators ---
# Unalterable admin privileges are strictly bound to these two accounts:
ADMIN_EMAIL_1=parthkadu05@gmail.com
ADMIN_EMAIL_2=atharvabhoite697@gmail.com

# --- Supabase (Production PostgreSQL, Realtime & Storage) ---
# Obtain from your Supabase Dashboard: Project Settings -> Database & API
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Frontend Supabase Client (Vite Build) ---
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Email (SMTP for password resets & notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@topperbatch.com

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Frontend URL (for CORS) ---
CLIENT_URL=http://localhost:5173
