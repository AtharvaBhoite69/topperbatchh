# ==========================================
# TopperBatch — Environment Configuration
# ==========================================
# Copy this file to .env and fill in values.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Security ---
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d
SESSION_SECRET=change-this-to-another-random-secret
COOKIE_DOMAIN=localhost

# --- Permanent Administrators ---
# Only these two emails will have admin privileges.
ADMIN_EMAIL_1=parthkadu05@gmail.com
ADMIN_EMAIL_2=atharvabhoite697@gmail.com

# --- Gemini AI ---
GEMINI_API_KEY=

# --- Email (for password reset & notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@topperbatch.com

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Frontend URL (for CORS) ---
CLIENT_URL=http://localhost:5173

